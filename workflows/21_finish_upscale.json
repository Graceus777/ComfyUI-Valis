{
  "v": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "valis/shot.mp4"
    }
  },
  "vc": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "v",
        0
      ]
    }
  },
  "dit": {
    "class_type": "SeedVR2LoadDiTModel",
    "inputs": {
      "model": "seedvr2_ema_3b-Q8_0.gguf",
      "device": "cuda:0",
      "offload_device": "cpu",
      "blocks_to_swap": 16
    }
  },
  "vae": {
    "class_type": "SeedVR2LoadVAEModel",
    "inputs": {
      "model": "ema_vae_fp16.safetensors",
      "device": "cuda:0",
      "offload_device": "cpu",
      "encode_tiled": true,
      "decode_tiled": true
    }
  },
  "up": {
    "class_type": "SeedVR2VideoUpscaler",
    "inputs": {
      "image": [
        "vc",
        0
      ],
      "dit": [
        "dit",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "seed": 42,
      "resolution": 1080,
      "max_resolution": 0,
      "batch_size": 9,
      "uniform_batch_size": false,
      "color_correction": "lab",
      "offload_device": "cpu"
    }
  },
  "out": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "up",
        0
      ],
      "fps": [
        "vc",
        2
      ],
      "audio": [
        "vc",
        1
      ]
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "out",
        0
      ],
      "filename_prefix": "valis/upscale",
      "format": "auto",
      "codec": "auto"
    }
  }
}
