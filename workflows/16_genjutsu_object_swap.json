{
  "v": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "valis/clip.mp4"
    }
  },
  "vs": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "v",
        0
      ],
      "start_time": 0,
      "duration": 5,
      "strict_duration": false
    }
  },
  "vc": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "vs",
        0
      ]
    }
  },
  "res": {
    "class_type": "ResolutionSelector",
    "inputs": {
      "aspect_ratio": "9:16 (Portrait Widescreen)",
      "megapixels": 0.4,
      "multiple": 32
    }
  },
  "sc": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "vc",
        0
      ],
      "upscale_method": "lanczos",
      "width": [
        "res",
        0
      ],
      "height": [
        "res",
        1
      ],
      "crop": "center"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "avae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "cn": {
    "class_type": "ModelPatchLoader",
    "inputs": {
      "name": "minimax_h3_fun_controlnet_union_2.0_pruned_int8_convrot.safetensors"
    }
  },
  "pr": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": [
        "vc",
        0
      ],
      "resize_type": "scale longer dimension",
      "resize_type.longer_size": 1024,
      "scale_method": "lanczos"
    }
  },
  "pm": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sdpose_wholebody_fp16.safetensors"
    }
  },
  "dm": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "rt_detr_v4-x-hgnet_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "det": {
    "class_type": "RTDETR_detect",
    "inputs": {
      "model": [
        "dm",
        0
      ],
      "image": [
        "pr",
        0
      ],
      "threshold": 0.5,
      "class_name": "person",
      "max_detections": 2
    }
  },
  "kp": {
    "class_type": "SDPoseKeypointExtractor",
    "inputs": {
      "model": [
        "pm",
        0
      ],
      "vae": [
        "pm",
        2
      ],
      "image": [
        "pr",
        0
      ],
      "bboxes": [
        "det",
        0
      ],
      "batch_size": 16
    }
  },
  "ctl": {
    "class_type": "SDPoseDrawKeypoints",
    "inputs": {
      "keypoints": [
        "kp",
        0
      ],
      "draw_body": true,
      "draw_hands": true,
      "draw_face": true,
      "draw_feet": true,
      "stick_width": 4,
      "face_point_size": 2,
      "score_threshold": 0.5,
      "draw_head": true
    }
  },
  "sm": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sam3.1_multiplex_fp16.safetensors"
    }
  },
  "st": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "red robe",
      "clip": [
        "sm",
        1
      ]
    }
  },
  "trk": {
    "class_type": "SAM3_VideoTrack",
    "inputs": {
      "images": [
        "sc",
        0
      ],
      "model": [
        "sm",
        0
      ],
      "conditioning": [
        "st",
        0
      ],
      "detection_threshold": 0.45,
      "max_objects": 1,
      "detect_interval": 5
    }
  },
  "tm": {
    "class_type": "SAM3_TrackToMask",
    "inputs": {
      "track_data": [
        "trk",
        0
      ],
      "object_indices": ""
    }
  },
  "mk": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "tm",
        0
      ],
      "expand": 16,
      "tapered_corners": true
    }
  },
  "ap": {
    "class_type": "MiniMaxH3FunControlNetApply",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "model_patch": [
        "cn",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "control_video": [
        "ctl",
        0
      ],
      "strength": 1,
      "start_percent": 0,
      "end_percent": 1,
      "mask": [
        "mk",
        0
      ],
      "source_video": [
        "sc",
        0
      ]
    }
  },
  "r2v": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "audio_vae": [
        "avae",
        0
      ],
      "prompt": "The red robe is replaced by a flowing robe of liquid gold, keeping its shape, folds and motion and matching the scene's light; everything else in the frame stays exactly the same. One continuous shot, no cuts, no text.",
      "width": [
        "res",
        0
      ],
      "height": [
        "res",
        1
      ],
      "length": 124,
      "ref_image_size": "match"
    }
  },
  "sched": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "ap",
        0
      ],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1
    }
  },
  "guide": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "ap",
        0
      ],
      "conditioning": [
        "r2v",
        0
      ]
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 1086
    }
  },
  "samp": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "run": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guide",
        0
      ],
      "sampler": [
        "samp",
        0
      ],
      "sigmas": [
        "sched",
        0
      ],
      "latent_image": [
        "r2v",
        1
      ]
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "run",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "adec": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "run",
        0
      ],
      "vae": [
        "avae",
        0
      ]
    }
  },
  "out": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "keep",
        0
      ],
      "fps": 24,
      "audio": [
        "vc",
        1
      ]
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "out",
        0
      ],
      "filename_prefix": "valis/genjutsu",
      "format": "auto",
      "codec": "auto"
    }
  },
  "cvs": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "ctl",
        0
      ],
      "upscale_method": "lanczos",
      "width": [
        "res",
        0
      ],
      "height": [
        "res",
        1
      ],
      "crop": "center"
    }
  },
  "cv": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "cvs",
        0
      ],
      "fps": 24
    }
  },
  "csave": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "cv",
        0
      ],
      "filename_prefix": "valis/genjutsu_control",
      "format": "auto",
      "codec": "auto"
    }
  },
  "keep": {
    "class_type": "ValisSwapMatch",
    "inputs": {
      "plate": [
        "sc",
        0
      ],
      "swapped": [
        "dec",
        0
      ],
      "mask": [
        "mk",
        0
      ],
      "color": 0,
      "grain": true,
      "soften": true,
      "light_wrap": 0.15
    }
  }
}
