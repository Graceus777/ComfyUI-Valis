{
  "v": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "valis/clip.mp4"
    }
  },
  "vs": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "v",
        0
      ],
      "start_time": 0,
      "duration": 5,
      "strict_duration": false
    }
  },
  "vc": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "vs",
        0
      ]
    }
  },
  "res": {
    "class_type": "ResolutionSelector",
    "inputs": {
      "aspect_ratio": "9:16 (Portrait Widescreen)",
      "megapixels": 0.4,
      "multiple": 32
    }
  },
  "sc": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "vc",
        0
      ],
      "upscale_method": "lanczos",
      "width": [
        "res",
        0
      ],
      "height": [
        "res",
        1
      ],
      "crop": "center"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_ref2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "avae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "cn": {
    "class_type": "ModelPatchLoader",
    "inputs": {
      "name": "minimax_h3_fun_controlnet_union_pruned_int8_convrot.safetensors"
    }
  },
  "ctl": {
    "class_type": "Canny",
    "inputs": {
      "image": [
        "sc",
        0
      ],
      "low_threshold": 0.25,
      "high_threshold": 0.6
    }
  },
  "ap": {
    "class_type": "MiniMaxH3FunControlNetApply",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "model_patch": [
        "cn",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "control_video": [
        "ctl",
        0
      ],
      "strength": 1,
      "start_percent": 0,
      "end_percent": 1
    }
  },
  "r2v": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "audio_vae": [
        "avae",
        0
      ],
      "prompt": "The whole video restyled as a hand-made clay stop-motion animation: plasticine figures with visible thumbprints on a miniature set, warm studio lights, slightly jerky stop-motion movement. The people, their motion, the timing and the camera follow the control video exactly. claymation One continuous shot, no cuts, no text.",
      "width": [
        "res",
        0
      ],
      "height": [
        "res",
        1
      ],
      "length": 124,
      "ref_image_size": "match"
    }
  },
  "sched": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "ap",
        0
      ],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1
    }
  },
  "guide": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "ap",
        0
      ],
      "conditioning": [
        "r2v",
        0
      ]
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 1086
    }
  },
  "samp": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "run": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guide",
        0
      ],
      "sampler": [
        "samp",
        0
      ],
      "sigmas": [
        "sched",
        0
      ],
      "latent_image": [
        "r2v",
        1
      ]
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "run",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "adec": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "run",
        0
      ],
      "vae": [
        "avae",
        0
      ]
    }
  },
  "out": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "dec",
        0
      ],
      "fps": 24,
      "audio": [
        "vc",
        1
      ]
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "out",
        0
      ],
      "filename_prefix": "valis/genjutsu",
      "format": "auto",
      "codec": "auto"
    }
  },
  "cvs": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "ctl",
        0
      ],
      "upscale_method": "lanczos",
      "width": [
        "res",
        0
      ],
      "height": [
        "res",
        1
      ],
      "crop": "center"
    }
  },
  "cv": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "cvs",
        0
      ],
      "fps": 24
    }
  },
  "csave": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "cv",
        0
      ],
      "filename_prefix": "valis/genjutsu_control",
      "format": "auto",
      "codec": "auto"
    }
  }
}
